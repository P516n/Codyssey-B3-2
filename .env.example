# .env.example - 환경변수 설정 템플릿
# 이 파일을 복사하여 .env 파일을 생성하고 실제 API 키를 입력하세요.
# 예: cp .env.example .env (또는 Windows: copy .env.example .env)

# 범용 AI API 키 (Codyssey 가상 키, Google Gemini, OpenAI, Anthropic 등 지원)
# Codyssey 가상 키 사용 예: AI_API_KEY=sk-cody-live-...
AI_API_KEY=your_api_key_here

# 선택 사항: 기본 프로바이더 지정 (codyssey, gemini, openai, anthropic, custom)
# AI_PROVIDER=codyssey

# 선택 사항: 사용할 모델명 지정 (기본값: gpt-5-mini, gemini-1.5-flash, gpt-4o-mini)
# AI_MODEL=gpt-5-mini

# 선택 사항: 사용자 정의 REST API 엔드포인트 Base URL (기본값: https://copa.codyssey.kr/v1)
# AI_BASE_URL=https://copa.codyssey.kr/v1
